# /etc/aegis/dataplane.env - non-secret settings of aegis-dataplane.service
# Copied by install-linux.sh on the first installation (root:root 0640). Full reference: docs/configuration.md
#
# Format: systemd EnvironmentFile - KEY=value per line, comments only on their own lines.
# Secrets are NOT configured here: the data-plane key (AEGIS_DATAPLANE_KEY_FILE) and the CA are systemd
# credentials (/etc/aegis/secrets/dataplane.key, /etc/aegis/ca/mitmproxy-ca.pem).
# AEGIS_CA_DIR / AEGIS_CONFDIR are container-only settings and are not used by the unit.

# Control-plane base URL (load balancer in cluster mode). https:// recommended across hosts.
CONTROL_PLANE_URL=https://aegis.corp.example
# CA bundle of an internal PKI that issued the control-plane certificate (must be readable by aegis-dp).
#AEGIS_CONTROL_PLANE_CA_FILE=/etc/aegis/ca/corp-root.pem

# Proxy listener (explicit proxy). Restrict access with the host firewall to the server subnets.
AEGIS_LISTEN_HOST=0.0.0.0
AEGIS_LISTEN_PORT=8080
AEGIS_PROXY_MODE=regular

# Behaviour before the first successful policy sync: closed = 503 (recommended).
AEGIS_FAIL_MODE=closed

# Ops endpoint (/healthz, /readyz, /metrics). Loopback by default; use 0.0.0.0:9091 + firewall for Prometheus.
AEGIS_OPS_ADDR=127.0.0.1:9091

# ClamAV (clamd). Empty = antivirus disabled.
#   Debian/Ubuntu (clamav-daemon, socket mode 666):   unix:///run/clamav/clamd.ctl
#   RHEL/Rocky (clamd@scan, scan.conf TCPSocket 3310): tcp://127.0.0.1:3310
AEGIS_CLAMD_ADDRESS=unix:///run/clamav/clamd.ctl
#AEGIS_CLAMD_TIMEOUT_SECONDS=60

# Worker name shown in the console (default: hostname).
#AEGIS_WORKER_ID=dp-fra-01
# Fallback URLs for block pages until the policy bundle provides them.
#AEGIS_PUBLIC_URL=https://aegis.corp.example
#DASHBOARD_URL=https://aegis.corp.example
#AEGIS_MAGIC_HOSTS=aegis.ca,mitm.it
#AEGIS_SYNC_INTERVAL_SECONDS=2
#AEGIS_THREAT_SYNC_INTERVAL_SECONDS=30

# Local access log (Squid/combined/JSON): off | stdout (journald) | /var/log/aegis-dataplane/access.log |
# syslog:///dev/log (local rsyslog) | syslog+tcp://siem.corp.example:514. Central forwarding of audit, traffic
# and security records is configured in the console (Settings -> Integrations -> Log export).
#AEGIS_ACCESS_LOG=/var/log/aegis-dataplane/access.log
#AEGIS_ACCESS_LOG_FORMAT=squid

# Largest request/response body relayed at all (mitmproxy body_size_limit), and the bytes of bodies the worker
# holds for inspection at the same time (default min(512m, AEGIS_BODY_SIZE_LIMIT); plan ~2 x budget + 256 MiB
# of memory, see docs/configuration.md "Data-plane memory sizing"), and the part of that budget one client may
# hold (1%-100%, never less than one complete scan). Log levels.
AEGIS_BODY_SIZE_LIMIT=1g
#AEGIS_BUFFER_BUDGET=512m
#AEGIS_BUFFER_CLIENT_SHARE=25%
AEGIS_MITM_LOG_LEVEL=info
AEGIS_LOG_LEVEL=INFO
