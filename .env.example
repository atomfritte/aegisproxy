# AegisProxy — environment for docker compose (copy to .env; never commit .env)
# Generate the secrets with:  ./scripts/gen-secrets.sh >> .env

AEGIS_VERSION=2.1.0

# Externally reachable URL of the console/API (used in block pages, install scripts, deep links).
# Use https:// in production (sets Secure cookies and HSTS).
AEGIS_PUBLIC_URL=http://localhost:8081
# host:port that servers use as their proxy (onboarding snippets). Default: host of AEGIS_PUBLIC_URL + :8080
AEGIS_PROXY_ADDRESS=

# Where to publish the console and the proxy on the host.
AEGIS_CONSOLE_BIND=127.0.0.1:8081
AEGIS_PROXY_BIND=0.0.0.0:8080

# Optional: password for the bootstrap Super Admin "admin" (min. 12 chars, 3 character classes).
# If empty a random password is written to the data volume: /data/secrets/initial-admin-password
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=

# Optional: bearer token required to scrape /metrics
AEGIS_METRICS_TOKEN=

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated CIDRs)
AEGIS_TRUSTED_PROXIES=

# Demo data with PUBLIC demo credentials — never enable in production
AEGIS_DEMO_MODE=false

# --- secrets (appended by scripts/gen-secrets.sh) ---
# AEGIS_JWT_SECRET=
# AEGIS_DATAPLANE_KEY=
