# AegisProxy — environment for docker compose (never commit .env)
# .env holds every secret of the deployment; create it readable by its owner only and append the secrets:
#   install -m 600 .env.example .env && ./scripts/gen-secrets.sh >> .env

AEGIS_VERSION=2.1.0

# Externally reachable URL of the console/API (used in block pages, install scripts, deep links).
# Use https:// in production (sets Secure cookies and HSTS).
AEGIS_PUBLIC_URL=http://localhost:8081
# host:port that servers use as their proxy (onboarding snippets). Default: host of AEGIS_PUBLIC_URL + :8080
AEGIS_PROXY_ADDRESS=

# Where to publish the console and the proxy on the host.
AEGIS_CONSOLE_BIND=127.0.0.1:8081
AEGIS_PROXY_BIND=0.0.0.0:8080

# Optional: password for the bootstrap Super Admin "admin" (min. 12 chars, 3 character classes).
# If empty a random password is written to the data volume: /data/secrets/initial-admin-password
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=

# Optional: bearer token required to scrape /metrics
AEGIS_METRICS_TOKEN=

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated CIDRs). Empty = the TCP peer is
# the client. List exactly the proxy's address as seen by the container (e.g. the compose network gateway
# 172.18.0.1/32 for a reverse proxy on the host), never whole private ranges.
AEGIS_TRUSTED_PROXIES=

# Workers fail closed (503 policy_stale) once their last successful policy sync is older than this, so a worker
# cut off from the control-plane cannot keep enforcing a policy without later quarantines or revocations.
# Default 10m; 0 = no limit (posture warning).
AEGIS_POLICY_MAX_AGE=10m

# Demo data with PUBLIC demo credentials — never enable in production
AEGIS_DEMO_MODE=false

# --- secrets (appended by scripts/gen-secrets.sh) ---
# AEGIS_JWT_SECRET=
# AEGIS_DATAPLANE_KEY=
