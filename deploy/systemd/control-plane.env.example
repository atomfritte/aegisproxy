# /etc/aegis/control-plane.env - non-secret settings of aegis-control-plane.service
# Copied by install-linux.sh on the first installation (root:root 0640). Full reference: docs/configuration.md
#
# Format: systemd EnvironmentFile - KEY=value per line, no "export", comments only on their own lines
# (a "#" after a value becomes part of the value).
#
# NEVER put secrets here. They are provided as systemd credentials from /etc/aegis/secrets:
#   jwt.key, dataplane.key                  -> always (unit file)
#   database-url, bootstrap-admin-password, metrics-token, tls.crt, tls.key, trusted-proxy-secret
#                                           -> optional, drop-in 10-credentials.conf (install-linux.sh)
# A plain AEGIS_JWT_SECRET / AEGIS_DATAPLANE_KEY here would take precedence over the credential files.

# --- network & URLs --------------------------------------------------------------------------------------
# Externally reachable base URL (block pages, install scripts, deep links). https:// enables Secure cookies + HSTS.
AEGIS_PUBLIC_URL=https://aegis.corp.example
# Console URL if hosted separately (defaults to AEGIS_PUBLIC_URL).
#AEGIS_DASHBOARD_URL=https://aegis-console.corp.example
# host:port servers use as their proxy, shown in onboarding snippets (default: AEGIS_PUBLIC_URL host + :8080).
#AEGIS_PROXY_ADDRESS=aegis-proxy.corp.example:8080

# Behind nginx on the same host: listen on loopback only (nginx terminates TLS, see deploy/nginx/).
AEGIS_LISTEN_ADDR=127.0.0.1:8081
# Without a local reverse proxy: listen on all interfaces (port only) and use native TLS (tls.crt/tls.key credentials).
#CONTROL_PLANE_PORT=8081

# Reverse proxies / load balancers whose X-Forwarded-For is trusted (comma-separated CIDRs or IPs).
# Empty = the TCP peer is the client. Loopback is shared by every local account: trust it only together with
# the proxy secret (credential trusted-proxy-secret -> AEGIS_TRUSTED_PROXY_SECRET_FILE, sent by nginx via
# include /etc/aegis/nginx-proxy-auth.conf). install-linux.sh sets both on a new installation, and on an
# existing one with --proxy-secret. nginx must replace X-Forwarded-For (proxy_set_header X-Forwarded-For
# $remote_addr;, deploy/nginx/aegis-console.conf), not append to the client's header.
#AEGIS_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Origins of a separately hosted console (enables credentialed CORS).
#AEGIS_CORS_ORIGINS=https://aegis-console.corp.example
#AEGIS_COOKIE_SAMESITE=strict
#AEGIS_SESSION_TTL=8h

# Internal DNS suffixes (only reachable with explicit, non-wildcard rules).
#AEGIS_INTERNAL_DOMAINS=.internal.corp,.local,.localdomain,.internal,.lan,.home.arpa,.corp

# --- persistence ----------------------------------------------------------------------------------------
# file = single node (/var/lib/aegis/data/aegis_state.json); postgres = active-active cluster
# (requires /etc/aegis/secrets/database-url, identical jwt.key/dataplane.key/CA on every node).
AEGIS_STORAGE=file
#AEGIS_FLOW_RETENTION=168h
#AEGIS_EVENT_RETENTION=2160h
#AEGIS_AUDIT_LOG=/var/lib/aegis/data/audit.jsonl
# DATA_DIR and CERTS_DIR are set by the unit (/var/lib/aegis/data, /var/lib/aegis/certs) - do not change
# them here unless you also adapt StateDirectory=/ReadOnlyPaths= in a drop-in.

# --- web console ---------------------------------------------------------------------------------------
# Built console served by the control-plane (install-linux.sh --ui-dir copies frontend/dist here).
#AEGIS_UI_DIR=/opt/aegis/console

# --- threat intelligence --------------------------------------------------------------------------------
#AEGIS_THREATINTEL_AUTOUPDATE=true
# Explicit proxy for feed downloads (otherwise HTTPS_PROXY/NO_PROXY of this environment).
#AEGIS_FEED_HTTP_PROXY=http://egress.corp.example:3128

# --- operations -----------------------------------------------------------------------------------------
AEGIS_LOG_LEVEL=info
# Logs go to the journal (journalctl -u aegis-control-plane). Only set a file for legacy log shippers:
#AEGIS_LOG_FILE=/var/log/aegis/control-plane.log
AEGIS_DEMO_MODE=false
