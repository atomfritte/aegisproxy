# AegisProxy control-plane (policy, threat intelligence, audit, API + optional web console)
# Installed by deploy/systemd/install-linux.sh to /etc/systemd/system/aegis-control-plane.service.
# Variable reference: docs/configuration.md - operations guide: docs/deployment/linux.md
#
# Identity: a dedicated static system user "aegis" (not DynamicUser=yes). Reasons:
#   * stable UID/GID for the persistent state in /var/lib/aegis (backups/restores keep ownership,
#     no /var/lib/private indirection that backup agents and SELinux policies have to know about)
#   * logrotate can use "su aegis aegis" for audit.jsonl (DynamicUser UIDs do not exist outside the unit)
#   * install-linux.sh provisions the CA certificate into /var/lib/aegis/certs before the first start
# The hardening below gives the same confinement DynamicUser would add (ProtectSystem=strict, RemoveIPC,
# PrivateTmp, NoNewPrivileges, RestrictSUIDSGID).
#
# Secrets never appear in the environment: systemd copies them from /etc/aegis/secrets (root:root 0600)
# into the per-unit credentials directory (%d, ramfs, readable only by this service) and the service reads
# them via AEGIS_*_FILE. Optional credentials (database-url, bootstrap-admin-password, metrics-token,
# tls.crt/tls.key) are added by install-linux.sh as a drop-in:
#   /etc/systemd/system/aegis-control-plane.service.d/10-credentials.conf
#     [Service]
#     LoadCredential=database-url:/etc/aegis/secrets/database-url
#     Environment=AEGIS_DATABASE_URL_FILE=%d/database-url
#
# The CA *private key* is not accessible to this service at all: it lives in /etc/aegis/ca/mitmproxy-ca.pem
# (root, 0600) and is handed to the data-plane only. /var/lib/aegis/certs holds the public certificate and
# is mounted read-only, so a missing certificate makes the service fail instead of silently creating a new,
# untrusted CA.

[Unit]
Description=AegisProxy control-plane
Wants=network-online.target
After=network-online.target
# Local PostgreSQL (cluster mode on the same host) - harmless if the unit does not exist:
After=postgresql.service

[Service]
Type=exec
User=aegis
Group=aegis
ExecStart=/usr/local/bin/aegis-control-plane

# Non-secret configuration (AEGIS_PUBLIC_URL, AEGIS_STORAGE, AEGIS_TRUSTED_PROXIES, ...).
# Settings in the file override the Environment= defaults below. Never put secrets into it.
Environment=DATA_DIR=/var/lib/aegis/data
Environment=CERTS_DIR=/var/lib/aegis/certs
Environment=AEGIS_LOG_FORMAT=json
EnvironmentFile=/etc/aegis/control-plane.env

# Mandatory secrets (generated by install-linux.sh, identical on every cluster replica).
LoadCredential=jwt:/etc/aegis/secrets/jwt.key
LoadCredential=dataplane:/etc/aegis/secrets/dataplane.key
LoadCredential=encryption:/etc/aegis/secrets/encryption.key
Environment=AEGIS_JWT_SECRET_FILE=%d/jwt
Environment=AEGIS_DATAPLANE_KEY_FILE=%d/dataplane
Environment=AEGIS_ENCRYPTION_KEY_FILE=%d/encryption

# /var/lib/aegis (state, audit.jsonl, threat-intel cache); /var/log/aegis only used with AEGIS_LOG_FILE.
StateDirectory=aegis aegis/data
StateDirectoryMode=0750
LogsDirectory=aegis
LogsDirectoryMode=0750
ReadOnlyPaths=/var/lib/aegis/certs
UMask=0077

Restart=on-failure
RestartSec=5s
TimeoutStartSec=60
TimeoutStopSec=30
LimitNOFILE=65536

# --- sandboxing ---------------------------------------------------------------------------------------
NoNewPrivileges=yes
# Port 8081 is unprivileged: no capabilities at all.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
# Static Go binary: no JIT, no W+X mappings.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private

[Install]
WantedBy=multi-user.target
