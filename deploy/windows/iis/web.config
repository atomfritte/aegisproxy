<?xml version="1.0" encoding="UTF-8"?>
<!--
  AegisProxy web console (static SPA, frontend/dist) on IIS 10.
  Equivalent of frontend/docker/nginx.conf + 40-aegis-config.sh.

  Requirements: IIS Static Content + URL Rewrite 2.1 (https://www.iis.net/downloads/microsoft/url-rewrite).
  Optional reverse proxy for /api: Application Request Routing 3.0 (ARR), see rule 2 below.
  Deployed by Install-AegisConsole-IIS.ps1 (which also writes config.js and, for -ApiBaseUrl, adds the API
  origin to connect-src). Application pool: "No Managed Code".

  Content-Security-Policy / connect-src:
    * API on the same origin (default, or via the ARR rule 2):  connect-src 'self'
    * API on another origin (config.js apiBaseUrl = https://aegis-api.corp.example):
        connect-src 'self' https://aegis-api.corp.example
      and on the control-plane: AEGIS_CORS_ORIGINS=https://<console origin>
      (plus AEGIS_COOKIE_SAMESITE=none only if console and API are on different *sites*).
-->
<configuration>
  <system.webServer>

    <!-- SPA: index.html is the default document; never list directories. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />

    <rewrite>
      <rules>
        <!-- 1. Enforce HTTPS (no-op when the site only has an https binding). -->
        <rule name="AegisHttpsRedirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. OPTIONAL same-origin API via ARR 3.0 (no CORS needed): Install-AegisConsole-IIS.ps1 -ApiProxyTarget
               http://127.0.0.1:8081 inserts the rule "AegisApiReverseProxy" at the marker below (and the location for
               the live-traffic stream at the end of this file). It enables the ARR proxy server-wide
               (preserveHostHeader, responseBufferLimit=0 for the Server-Sent Events stream /api/flows/stream,
               includePortInXForwardedFor=false) and allows the server variables HTTP_X_FORWARDED_PROTO and
               HTTP_X_AEGIS_PROXY_AUTH for this site.
             The rule sends the control-plane's proxy secret in X-Aegis-Proxy-Auth (replacing a header of that name
             sent by the client). IIS connects from 127.0.0.1, which every local account can use as well: the
             control-plane (AEGIS_TRUSTED_PROXIES=127.0.0.1/32, AEGIS_PUBLIC_URL=https://<this site>) accepts the
             X-Forwarded-For that ARR appends only together with AEGIS_TRUSTED_PROXY_SECRET(_FILE). The deployed
             web.config therefore holds a secret: the installer restricts the site directory to SYSTEM,
             Administrators and the application pool. -->
        <!-- aegis:api-proxy-rule -->

        <!-- 3. Client-side routing: unknown paths render index.html. Real files, /assets/*, /config.js and
               /api/* are never rewritten (a missing asset must be a 404, not HTML). -->
        <rule name="AegisSpaFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(assets/|config\.js|api/)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!-- CSP: add the API origin to connect-src when config.js points to another origin (see header). -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <!-- Ignored by browsers on plain http; effective once served via https. -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true" allowDoubleEscaping="false">
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".map" allowed="false" />
        </fileExtensions>
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <!-- Needed only with the ARR /api rule: -->
          <add verb="POST" allowed="true" />
          <add verb="PUT" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <staticContent>
      <!-- Default for HTML/SPA entry points: always revalidate. -->
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript; charset=utf-8" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript; charset=utf-8" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css; charset=utf-8" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

  </system.webServer>

  <!-- Hashed build artefacts never change: cache for one year (immutable). -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Runtime configuration: must never be cached. -->
  <location path="config.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" cacheControlCustom="no-store" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- With the ARR rule: no compression on the SSE stream (inserted by -ApiProxyTarget). -->
  <!-- aegis:api-proxy-location -->
</configuration>
